# Development settings. Copy to .env (git-ignored) and fill in; the real environment always wins.
# Do not use this in production: there the key comes from a Docker secret, a systemd credential
# or GEMINI_API_KEY_FILE (docs/radix/operations.md, section 3).

GEMINI_API_KEY=

# Optional service settings, see `radix run --help`
# RADIX_OFFPEAK=any
# RADIX_LOG_FORMAT=text
