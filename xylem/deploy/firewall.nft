#!/usr/sbin/nft -f
# Xylem's own firewall (docs/xylem/xylem.md, „On the server"; docs/xylem/protocol.md section 2).
#
# `xylem start` loads it in the container's network namespace, as root with NET_ADMIN, before
# Xylem serves; Xylem then runs as 65532 without any capability and cannot change it. Xylem has
# to reach the push services of the browsers (Google's, Mozilla's, Apple's, Microsoft's: many
# addresses, which change) and the site's feed, so it has a way out, and this is what the way is
# held to:
#
#   in:  loopback (the health check and the commands, 127.0.0.1 to 127.0.0.1), replies, and new
#        TCP connections to 8300 (Traefik, over <stack>_in: the only other member of that network)
#   out: replies; loopback to 127.0.0.1; a name asked of Docker's resolver (127.0.0.11, which asks
#        the host's resolvers from the host's side); and new TCP connections to port 443 of an
#        address on the internet. Nothing to an address that is none (the house: every other
#        container, the host's own networks, the metadata service), no other port, no datagram,
#        no IPv6.
#
# Docker has no allowlist of hosts for a container's way out, and neither has this: a Xylem taken
# over could speak HTTPS to any address on the internet. It could not reach anything inside the
# house, nor be reached but on 8300.
#
# Every chain ends with a counting drop, and every drop that means someone tried something is
# counted, in the chain it happened in. betula-xylem-guard (deploy/vps/files, every minute as
# root on the host) reads the counters from outside, per chain; the monitoring alerts on any
# packet they count (rule "Xylem: its firewall drops connections"). Drops by a chain's policy
# would be invisible to it: the policy is only the backstop behind the last rule.
#
# Three drops are not counted, on purpose, since none of them is anyone trying anything:
#   - `xylem start`'s own check that the firewall holds: one datagram to 192.0.2.1 port 9 (an
#     address of the documentation range, RFC 5737: nobody's), sent as root before it drops its
#     rights (meta skuid 0: the uid that made the socket). Counted, every start (a reboot at
#     night, a restart by swarm) would set off the alarm. Xylem itself never runs as root: as
#     65532, the same datagram is counted below.
#   - packets conntrack cannot place (ct state invalid): late segments of a connection it let go
#     already, which happen now and then in any normal traffic.
#   - IPv6's neighbour discovery (ICMPv6: router and neighbour solicitations and advertisements,
#     redirects, multicast listener queries and reports), which the kernels on a link send by
#     themselves. <stack>_out leads out over docker_gwbridge, which has IPv6 since 2026-11
#     (deploy/README.md section 15, "IPv6 to Traefik"), so the container has an address on it,
#     and its kernel asks for a router once an hour for as long as none answers (RFC 7559:
#     router_solicitations -1, router_solicitation_max_interval 3600). Counted, that set off
#     Phloem's alarm every hour, whose container is on the bridge the same way (2026-11-12 to
#     11-19; phloem/deploy/firewall.nft). No process sends them: one without capabilities can
#     open no socket that sends neighbour discovery, and whatever Xylem itself could send over
#     IPv6 (TCP, UDP, a ping) meets the counting rule after them before any neighbour is asked
#     for.
#
# Docker's NAT rewrites port 53 of its resolver to the one it listens on before this table sees
# the packet (nat comes before filter), so the rules ask conntrack for the port it was sent to.
# The resolver listens in this namespace: the question passes output and then input.
#
# One transaction: the table is made (if it is missing), deleted and made anew, so that loading
# the file twice gives the same rules. Docker's own rules (its resolver's NAT) live in tables of
# their own and stay; this table drops what they would let through.

table inet xylem
delete table inet xylem

table inet xylem {
	# No address on the internet (RFC 6890 and its updates), as internal/server/endpoint.go's
	# special: Xylem's own rule for the address of a push service, and this one behind it.
	set special {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24, 192.168.0.0/16, 192.175.48.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
	}

	chain input {
		type filter hook input priority filter; policy drop;
		icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect, mld2-listener-report } drop comment "IPv6 neighbour discovery, the kernels' own: noise, not counted"
		meta nfproto ipv6 counter drop comment "IPv6: none, either way"
		ct state established,related accept
		ct state invalid drop comment "late packets conntrack cannot place: noise, not counted"
		iif "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 accept
		iif "lo" ip daddr 127.0.0.11 meta l4proto { tcp, udp } ct original proto-dst 53 accept comment "a name asked of Docker's resolver, which listens in this namespace"
		tcp dport 8300 ct state new accept
		counter drop comment "a new connection to another port, or anything else"
	}

	chain output {
		type filter hook output priority filter; policy drop;
		icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, nd-redirect, mld2-listener-report } drop comment "IPv6 neighbour discovery, the kernel's own: noise, not counted"
		meta nfproto ipv6 counter drop comment "IPv6: none, either way"
		ct state established,related accept
		ct state invalid drop comment "late packets conntrack cannot place: noise, not counted"
		oif "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 accept
		ip daddr 127.0.0.11 meta l4proto { tcp, udp } ct original proto-dst 53 accept comment "a name asked of Docker's resolver: a push service's, the site's"
		meta skuid 0 ip daddr 192.0.2.1 udp dport 9 drop comment "xylem start's own check, as root before the drop: not counted"
		ip daddr @special counter drop comment "no address on the internet: the house, the host, the metadata service"
		tcp dport 443 ct state new accept comment "a push service, or the site's feed"
		counter drop comment "another port, a datagram, anything else out"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		counter drop comment "nothing is routed through"
	}
}
