# The instance "canary-green": the second colour of https://canary.betula.app (blue-green,
# README.md section 4). canary.env is the first; the two files name the same APP_HOST, and the
# router with the higher priority gets the host (vps/lib-stacks.sh). A stack of its own, with
# volumes of its own (canary-green_radix-data, canary-green_folia-data).
#
#   deploy/ship.sh canary-green --seed                        # first deploy: standby, with this machine's radix.db
#   bash /opt/betula/vps/55-switch.sh canary-green            # takes https://canary.betula.app over
#   bash /opt/betula/vps/55-switch.sh canary                  # and gives it back (the rollback)
#
# Two colours of one site have to agree on FOLIA_ACCESS_GATE (a switch must not open or close the
# site) and both say RADIX_CRAWL=off (two Radix that crawl would ask the university for
# everything twice); 50-app.sh refuses anything else.

STACK_NAME=canary-green
APP_HOST=canary.betula.app
# As in canary.env: the whole site asks for the password in the swarm secret folia-access-password.
FOLIA_ACCESS_GATE=on
# As in canary.env, and the same in both colours (50-app.sh refuses anything else): not listed.
FOLIA_INDEXING=off
# As in canary.env: Radix sends NOTHING to the university and only serves the snapshot it has.
# The data is this machine's radix.db of 2026-09-23 (seeded with the first deploy).
RADIX_CRAWL=off
