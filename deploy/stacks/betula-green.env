# The instance "betula-green": the second colour of the public site at https://betula.app
# (blue-green, README.md section 4). betula.env is the first; the two files name the same
# APP_HOST, and the router with the higher priority gets the host (vps/lib-stacks.sh). A stack of
# its own, with volumes of its own (betula-green_radix-data, betula-green_folia-data).
#
#   SEED_DB=<betula's radix.db> deploy/ship.sh betula-green --seed   # first deploy: standby
#   bash /opt/betula/vps/55-switch.sh betula-green                    # takes https://betula.app over
#   bash /opt/betula/vps/55-switch.sh betula                          # and gives it back (the rollback)
#
# Two colours of one site agree on FOLIA_ACCESS_GATE (a switch must not open or close the site),
# and at most one of them says RADIX_CRAWL=on (two Radix that crawl would ask the university for
# everything twice); 50-app.sh refuses anything else.

STACK_NAME=betula-green
APP_HOST=betula.app
# As in betula.env: open to everybody.
FOLIA_ACCESS_GATE=off
# on: this colour keeps the catalog fresh. Seeded on 2026-09-27 with betula's radix.db, copied
# after betula's Radix had stopped crawling, so that nothing it fetched is lost.
RADIX_CRAWL=on
