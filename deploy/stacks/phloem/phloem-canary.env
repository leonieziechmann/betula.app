# The instance "phloem-canary": Betula Sync of https://canary.betula.app, the closed test (stacks/phloem.yml,
# docs/phloem/phloem.md). Plain NAME=value lines, read (never sourced) by vps/47-phloem-host.sh
# and vps/49-phloem.sh (vps/lib-phloem.sh); no quotes, no spaces. A stack of its own, with its
# own network, data and numbers: what canary tries never touches the data of betula.app.
#
#   deploy/ship-phloem.sh phloem-canary                     # build, load, deploy
#   bash /opt/betula/vps/49-phloem.sh phloem-canary <tag>   # deploy a tag that is loaded already

STACK_NAME=phloem-canary
APP_HOST=canary.betula.app
PHLOEM_ORIGINS=https://canary.betula.app
# A test: 2 GB.
PHLOEM_BUDGET_BYTES=2000000000
PHLOEM_DATA_SIZE=3G
