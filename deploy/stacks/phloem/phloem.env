# The instance "phloem": Betula Sync of https://betula.app (stacks/phloem.yml, docs/phloem/phloem.md).
# Plain NAME=value lines, read (never sourced) by vps/47-phloem-host.sh and vps/49-phloem.sh
# (vps/lib-phloem.sh); no quotes, no spaces. In a directory of its own on purpose: every
# stacks/*.env is an instance of the application (vps/lib-stacks.sh, instance_names).
#
#   deploy/ship-phloem.sh phloem                     # build, load, deploy
#   bash /opt/betula/vps/49-phloem.sh phloem <tag>   # deploy a tag that is loaded already (the rollback)
#
# A change here reaches the server with deploy/sync.sh; PHLOEM_DATA_SIZE then needs
# sudo bash /opt/betula/vps/47-phloem-host.sh (it grows the file system; it never shrinks one),
# the rest a deploy with 49-phloem.sh.

STACK_NAME=phloem
APP_HOST=betula.app
# The browser origins Phloem takes for its WebSocket and answers CORS for: the site's own.
PHLOEM_ORIGINS=https://betula.app
# What all spaces together may hold: at it, no new space and no parcel (507); the spaces there go
# on. 50 GB (owner, 2026-11-05: „<50gb für profile kein problem").
PHLOEM_BUDGET_BYTES=50000000000
# The file system of its own that holds /data (a sparse file on a loop device): the budget, the
# WAL, and room for SQLite. Phloem cannot fill more than this, whatever it does.
PHLOEM_DATA_SIZE=56G
