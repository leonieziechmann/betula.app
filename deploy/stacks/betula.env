# The instance "betula": the public site at https://betula.app (stacks/betula.yml), released on
# 2026-09-27. Plain NAME=value lines, read by vps/50-app.sh and vps/91-verify-stacks.sh; no quotes, no spaces.
# A change here reaches the server with: deploy/sync.sh, then bash /opt/betula/vps/50-app.sh betula
#
#   deploy/ship.sh betula                                     # build, load, deploy
#   bash /opt/betula/vps/50-app.sh betula <tag>               # deploy a tag that is loaded already (the rollback)
#
# One colour only: blue-green needs RADIX_CRAWL=off in both colours (two Radix that crawl would ask
# the university for everything twice), and this instance crawls. Its router outranks the
# placeholder's (priority 1), which answers for https://betula.app while this instance has no
# healthy web server.

STACK_NAME=betula
APP_HOST=betula.app
# off: open to everybody. Impressum and Datenschutz are final (app/src/pages/legal.rs,
# PLACEHOLDER = false; ship.sh checks it).
FOLIA_ACCESS_GATE=off
# on: Radix keeps the catalog fresh (it fetches what has aged, politely, in the off-peak hours).
# Seeded on 2026-09-27 with the workstation's radix.db: its Termine read that day, everything else
# back-dated by 40 days so that Radix reads it again in its first nights.
RADIX_CRAWL=on
