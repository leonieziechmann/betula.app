# The instance "betula": the public site at https://betula.app (stacks/betula.yml), released on
# 2026-09-27. Plain NAME=value lines, read by vps/50-app.sh and vps/91-verify-stacks.sh; no quotes, no spaces.
# A change here reaches the server with: deploy/sync.sh, then bash /opt/betula/vps/50-app.sh betula
#
#   deploy/ship.sh betula                                     # build, load, deploy
#   bash /opt/betula/vps/50-app.sh betula <tag>               # deploy a tag that is loaded already (the rollback)
#
# betula-green.env is the second colour of the same site (blue-green, README.md section 4):
# vps/55-switch.sh <instance> hands https://betula.app to one of the two. Only one of them crawls
# (two Radix that crawl would ask the university for everything twice), and its database goes
# with the crawl to the colour that takes over. The routers of both outrank the placeholder's
# (priority 1), which answers for https://betula.app while neither has a healthy web server.

STACK_NAME=betula
APP_HOST=betula.app
# off: open to everybody. Impressum and Datenschutz are final (folia/crates/app/src/pages/legal.rs,
# PLACEHOLDER = false; ship.sh checks it).
FOLIA_ACCESS_GATE=off
# on since 2026-10-26, through Cortex (owner: „Ja zieh mal main auf Cortex um"): seeded with
# betula-green's radix.db, copied after its Radix had stopped crawling, so that nothing it fetched
# is lost. Release 2026-10-26-radix-006140f-folia-f5bdbba (README.md section 4, „A release of two
# lines"): canary's Radix (2026-10-26-006140f) with Folia 1.0.4 of branch claude/main-folia-markdown
# (436f93c, the title fix and the module texts as Markdown), so that the public site keeps the Folia
# of 2026-09-30. Before: off from 2026-09-30 11:08 UTC (the rollback), crawled from the handover of
# 2026-09-29 until then.
RADIX_CRAWL=on
