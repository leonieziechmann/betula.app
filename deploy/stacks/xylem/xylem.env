# The instance "xylem": the notifications of https://betula.app (stacks/xylem.yml,
# docs/xylem/xylem.md). Plain NAME=value lines, read (never sourced) by vps/47-xylem-host.sh and
# vps/49-xylem.sh (vps/lib-xylem.sh); no quotes, no spaces. In a directory of its own on purpose:
# every stacks/*.env is an instance of the application (vps/lib-stacks.sh, instance_names).
#
#   deploy/ship-xylem.sh xylem                      # build, load, deploy
#   bash /opt/betula/vps/49-xylem.sh xylem <tag>    # deploy a tag that is loaded already (the rollback)
#
# A change here reaches the server with deploy/sync.sh; XYLEM_DATA_SIZE then needs
# sudo bash /opt/betula/vps/47-xylem-host.sh (it grows the file system; it never shrinks one),
# the rest a deploy with 49-xylem.sh.

STACK_NAME=xylem
APP_HOST=betula.app
# The language every announcement is written in: a browser whose own language an announcement
# has no text in reads this one.
XYLEM_LANG=de
# What Betula announces by itself (docs/xylem/protocol.md section 7): the site's feed, read every
# ten minutes at the site's public address. on: https://<APP_HOST>/api/announcements; off: only a
# person announces (`xylem announce`).
XYLEM_FEED=on
# How many browsers may subscribe: at it no new one (507); the ones there go on. A subscription
# is about 500 bytes.
XYLEM_MAX_SUBSCRIPTIONS=200000
# The file system of its own that holds /data (a sparse file on a loop device): xylem.db, its
# WAL, and room for SQLite. Xylem cannot fill more than this, whatever it does.
XYLEM_DATA_SIZE=1G
