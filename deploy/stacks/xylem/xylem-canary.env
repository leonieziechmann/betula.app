# The instance "xylem-canary": the notifications of https://canary.betula.app, the closed test
# (stacks/xylem.yml, docs/xylem/xylem.md). Plain NAME=value lines, read (never sourced) by
# vps/47-xylem-host.sh and vps/49-xylem.sh (vps/lib-xylem.sh); no quotes, no spaces. A stack of
# its own, with its own networks, data, key and numbers: who subscribes here is never told what
# betula.app announces.
#
#   deploy/ship-xylem.sh xylem-canary                      # build, load, deploy
#   bash /opt/betula/vps/49-xylem.sh xylem-canary <tag>    # deploy a tag that is loaded already

STACK_NAME=xylem-canary
APP_HOST=canary.betula.app
XYLEM_LANG=de
# The feed of canary's own catalog (stacks/xylem/xylem.env says what it is): open without the
# password of the closed test (folia/crates/server/src/access.rs).
XYLEM_FEED=on
# A test: a few testers.
XYLEM_MAX_SUBSCRIPTIONS=2000
XYLEM_DATA_SIZE=256M
