# The instance "canary": the closed test at https://canary.betula.app (stacks/betula.yml).
# Plain NAME=value lines, read by vps/50-app.sh and vps/91-verify-stacks.sh; no quotes, no spaces.
# A change here reaches the server with: deploy/sync.sh, then bash /opt/betula/vps/50-app.sh canary
#
#   deploy/ship.sh canary                                     # build, load, deploy
#   bash /opt/betula/vps/50-app.sh canary <tag>               # deploy a tag that is loaded already
#
# The name needs a DNS record that points to the server before the first deploy (measured
# 2026-09-21: canary.betula.app is a CNAME of betula.app); 50-app.sh checks it, because a router
# for a name that does not resolve here makes Traefik order a certificate that cannot be validated.
#
# canary-green.env is the second colour of the same site (blue-green, README.md section 4):
# vps/55-switch.sh <instance> hands https://canary.betula.app to one of the two.

STACK_NAME=canary
APP_HOST=canary.betula.app
# on: the whole site asks for the password in the swarm secret folia-access-password.
# off: open to everybody. Only with the legal pages in place: ship.sh refuses while
# folia/crates/app/src/pages/legal.rs still says PLACEHOLDER = true.
FOLIA_ACCESS_GATE=on
# on: Radix keeps the catalog fresh (it fetches what has aged, politely, in the off-peak hours).
# off: Radix sends NOTHING to the university and only serves the snapshot it has (stacks/
# betula.offline.yml). cortex-offline: Radix runs its cycles as one that crawls does, but takes
# every page from Cortex's store alone (stacks/betula.cortex-offline.yml): it sends nothing to the
# university either. Owner, 2026-09-21: no crawling for the time of the closed test - the crawler
# names betula.app, and while that site shows only a login page its requests invite a block. Since
# canary follows master (vps/canary-agent.sh, README.md section 12) it never crawls: every deploy
# brings a fresh copy of the public site's database, whose own Radix does the crawling, and the
# agent refuses a canary colour that would crawl a second time.
# Owner, 2026-10-04: cortex-offline, to test Cortex without the public site ("setze das canary
# radix so ein, dass es cortex im offline modus verwendet ... ohne main zu stören"). Without a
# Cortex that runs, 50-app.sh deploys it off and says so.
RADIX_CRAWL=cortex-offline
