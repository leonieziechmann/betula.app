# The instance "canary": the closed test at https://canary.betula.app (stacks/betula.yml).
# Plain NAME=value lines, read by vps/50-app.sh and vps/91-verify-stacks.sh; no quotes, no spaces.
#
#   deploy/ship.sh canary                                     # build, load, deploy
#   bash /opt/betula/vps/50-app.sh canary <tag>               # deploy a tag that is loaded already
#
# The name needs a DNS record that points to the server before the first deploy (measured
# 2026-09-21: canary.betula.app is a CNAME of betula.app); 50-app.sh checks it, because a router
# for a name that does not resolve here makes Traefik order a certificate that cannot be validated.

STACK_NAME=canary
APP_HOST=canary.betula.app
# on: the whole site asks for the password in the swarm secret folia-access-password.
# off: open to everybody. Only with the legal pages in place.
FOLIA_ACCESS_GATE=on
