    {
      "id": 32,
      "type": "timeseries",
      "title": "Latency p95 / p50",
      "description": "Estimated from Traefik's histogram buckets (0.1, 0.3, 1.2, 5 s), so it moves in steps.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 36},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_entrypoint_request_duration_seconds_bucket{entrypoint=\"websecure\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
