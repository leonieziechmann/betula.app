    {
      "id": 13,
      "type": "timeseries",
      "title": "Network (host interfaces)",
      "description": "From cAdvisor's root cgroup: Alloy's node exporter runs in a container and would only see the container's own interfaces. Outgoing traffic is drawn below zero.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 19},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "8 * sum by (interface) (rate(container_network_receive_bytes_total{id=\"/\", interface!~\"lo|docker.*|br-.*|veth.*|vx-.*|ov-.*\"}[$__rate_interval]))",
          "legendFormat": "{{interface}} in",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "-8 * sum by (interface) (rate(container_network_transmit_bytes_total{id=\"/\", interface!~\"lo|docker.*|br-.*|veth.*|vx-.*|ov-.*\"}[$__rate_interval]))",
          "legendFormat": "{{interface}} out",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"mode": "none", "group": "A"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
