      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(betula:visitors:24h)",
          "legendFormat": "visitors in the last 24 h",
          "instant": false,
          "range": true
