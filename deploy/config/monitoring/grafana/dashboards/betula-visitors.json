      "type": "piechart",
      "title": "Device, last 7 days",
      "description": "Phone (iPhone, Android with Mobile), Tablet (iPad, Android without Mobile), Desktop. iPads that ask for the desktop site count as Desktop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
