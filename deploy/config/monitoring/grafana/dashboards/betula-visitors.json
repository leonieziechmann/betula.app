    {
      "id": 15,
      "type": "bargauge",
      "title": "Crawlers by name",
      "description": "Requests in the range by crawler: the word with bot/crawl/spider in its user agent. Google's renderer sends a Nexus 5X agent without that word.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort_desc(topk(10, sum by (crawler) (sum_over_time(last_over_time(betula:requests:1h{crawler!=\"\"}[10m])[$__range:1h]))))",
          "legendFormat": "{{crawler}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
