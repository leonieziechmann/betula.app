            "fillOpacity": 20,
            "barAlignment": -1,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "insertNulls": false
