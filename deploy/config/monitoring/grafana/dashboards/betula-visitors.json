    {
      "id": 7,
      "type": "timeseries",
      "title": "Visitors, rolling 24 h",
      "description": "At each point: browsers that started the app in the 24 hours before it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
