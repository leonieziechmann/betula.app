    {
      "id": 14,
      "type": "timeseries",
      "title": "Requests: Google, other crawlers, everything else",
      "description": "All requests to betula.app per hour. \"Everything else\" is people plus scanners and tools without a crawler user agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 23
