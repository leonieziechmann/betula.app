            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sum_over_time(last_over_time(betula:app_starts:1h[10m])[$__range:1h]))",
          "legendFormat": "app starts",
          "instant": true,
          "range": false
