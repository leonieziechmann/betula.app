{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "betula-logs"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Logs explorer for all containers and the host journal. Provisioned from deploy/config/monitoring/grafana/dashboards - edit there.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Lines by level",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (detected_level) (count_over_time({job=~\"$source\", stack=~\"$stack\", service=~\"$service\"} | detected_level=~\"$level\" |~ `(?i)$filter` [$__auto]))",
                        "legendFormat": "{{detected_level}}",
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": [
                    "sum"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "bars",
                    "fillOpacity": 70,
                    "lineWidth": 1,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "normal"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^critical$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "purple",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^fatal$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "purple",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^error$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^warn$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "orange",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^info$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "green",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^debug$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^trace$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "light-blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": "^unknown$"
                    },
                    "properties": [
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "#8e8e8e",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Log lines",
          "description": "Container logs carry stack / service / container, journal lines carry unit. Open a line for all fields; JSON lines of Radix show event and msg there.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "loki"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{job=~\"$source\", stack=~\"$stack\", service=~\"$service\"} | detected_level=~\"$level\" |~ `(?i)$filter`",
                        "legendFormat": "",
                        "maxLines": 1000,
                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "logs",
            "version": "",
            "spec": {
              "options": {
                "dedupStrategy": "none",
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showLabels": false,
                "showTime": true,
                "sortOrder": "Descending",
                "wrapLogMessage": true
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "",
              "collapse": false,
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "",
                        "hideHeader": true,
                        "collapse": false,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "maxColumnCount": 1,
                            "columnWidthMode": "custom",
                            "columnWidth": 600,
                            "rowHeightMode": "custom",
                            "rowHeight": 290,
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-1"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "title": "",
                        "hideHeader": true,
                        "collapse": false,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "maxColumnCount": 1,
                            "columnWidthMode": "custom",
                            "columnWidth": 600,
                            "rowHeightMode": "custom",
                            "rowHeight": 440,
                            "fillScreen": true,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-2"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "fillScreen": true
                      }
                    }
                  ]
                }
              },
              "hideHeader": true,
              "fillScreen": true
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Betula",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": [
          "betula"
        ],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": false,
        "keepTime": true
      }
    ],
    "liveNow": false,
    "preload": false,
    "tags": [
      "betula"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m"
      ],
      "hideTimepicker": false,
      "weekStart": "monday",
      "fiscalYearStartMonth": 0
    },
    "title": "Logs",
    "variables": [
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "source",
          "query": "docker,journal",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [
            {
              "selected": true,
              "text": "All",
              "value": "$__all"
            },
            {
              "selected": false,
              "text": "docker",
              "value": "docker"
            },
            {
              "selected": false,
              "text": "journal",
              "value": "journal"
            }
          ],
          "multi": true,
          "includeAll": true,
          "allValue": ".+",
          "label": "Source",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "stack",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "label": "Stack",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "loki"
            },
            "spec": {
              "label": "stack",
              "refId": "LokiVariableQueryEditor-VariableQuery",
              "stream": "",
              "type": 1
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "service",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "label": "Service",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "loki",
            "version": "v0",
            "datasource": {
              "name": "loki"
            },
            "spec": {
              "label": "service",
              "refId": "LokiVariableQueryEditor-VariableQuery",
              "stream": "{job=~\".+\", stack=~\"$stack\"}",
              "type": 1
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "allowCustomValue": true
        }
      },
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "level",
          "query": "critical,fatal,error,warn,info,debug,trace,unknown",
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "options": [
            {
              "selected": true,
              "text": "All",
              "value": "$__all"
            },
            {
              "selected": false,
              "text": "critical",
              "value": "critical"
            },
            {
              "selected": false,
              "text": "fatal",
              "value": "fatal"
            },
            {
              "selected": false,
              "text": "error",
              "value": "error"
            },
            {
              "selected": false,
              "text": "warn",
              "value": "warn"
            },
            {
              "selected": false,
              "text": "info",
              "value": "info"
            },
            {
              "selected": false,
              "text": "debug",
              "value": "debug"
            },
            {
              "selected": false,
              "text": "trace",
              "value": "trace"
            },
            {
              "selected": false,
              "text": "unknown",
              "value": "unknown"
            }
          ],
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "label": "Level",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "filter",
          "current": {
            "text": "",
            "value": ""
          },
          "query": "",
          "label": "Text filter (regex, case-insensitive)",
          "hide": "dontHide",
          "skipUrlSync": false,
          "description": "RE2 regex, inserted as a raw LogQL string: quotes and backslashes work as typed (DownstreamStatus\":5, \\d+ ms). Only a backtick cannot be used."
        }
      }
    ]
  }
}
