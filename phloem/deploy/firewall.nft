#!/usr/sbin/nft -f
# Phloem's own firewall (docs/phloem/phloem.md, „Firewall"; docs/phloem/protocol.md section 2).
#
# `phloem start` loads it in the container's network namespace, as root with NET_ADMIN, before
# Phloem serves; Phloem then runs as 65532 without any capability and cannot change it. Step 1:
# Phloem opens no connection at all.
#
#   in:  loopback (the health check, 127.0.0.1 to 127.0.0.1), replies, and new TCP
#        connections to 8200 (Traefik, over <stack>_in: the only other member of that network)
#   out: replies, and loopback to 127.0.0.1. No new connection, no DNS (Docker's resolver at
#        127.0.0.11 neither), no IPv6.
#
# Every chain ends with a counting drop, and every drop that means someone tried something is
# counted, in the chain it happened in. betula-phloem-guard (deploy/vps/files, every minute as
# root on the host) reads the counters from outside, per chain; the monitoring alerts on any
# packet they count (rule "Phloem: its firewall drops connections"). Drops by a chain's policy
# would be invisible to it: the policy is only the backstop behind the last rule.
#
# Two drops are not counted, on purpose, since neither is anyone trying anything:
#   - `phloem start`'s own check that the firewall holds: one DNS datagram to 127.0.0.11, sent as
#     root before it drops its rights (meta skuid 0: the uid that made the socket). Counted,
#     every start (a reboot at night, a restart by swarm) would set off the alarm. Phloem itself
#     never runs as root: as 65532, the same datagram is counted below. Docker's NAT rewrites
#     port 53 of its resolver to the one it listens on before this table sees the packet (nat
#     comes before filter), so the rule asks conntrack for the port it was sent to.
#   - packets conntrack cannot place (ct state invalid): late segments of a connection it let go
#     already, which happen now and then in any normal traffic.
#
# One transaction: the table is made (if it is missing), deleted and made anew, so that loading
# the file twice gives the same rules. Docker's own rules (its resolver's NAT) live in tables of
# their own and stay; this table drops what they would let through.

table inet phloem
delete table inet phloem

table inet phloem {
	chain input {
		type filter hook input priority filter; policy drop;
		meta nfproto ipv6 counter drop comment "IPv6: none, either way"
		ct state established,related accept
		ct state invalid drop comment "late packets conntrack cannot place: noise, not counted"
		iif "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 accept
		tcp dport 8200 ct state new accept
		counter drop comment "a new connection to another port, or anything else"
	}

	chain output {
		type filter hook output priority filter; policy drop;
		meta nfproto ipv6 counter drop comment "IPv6: none, either way"
		ct state established,related accept
		ct state invalid drop comment "late packets conntrack cannot place: noise, not counted"
		meta skuid 0 ip daddr 127.0.0.11 meta l4proto udp ct original proto-dst 53 drop comment "phloem start's own check, as root before the drop: not counted"
		ip daddr 127.0.0.11 counter drop comment "Docker's resolver: a name looked up"
		oif "lo" ip saddr 127.0.0.1 ip daddr 127.0.0.1 accept
		counter drop comment "a connection or a datagram out"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		counter drop comment "nothing is routed through"
	}
}
